{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "HealthController_live",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Processo vivo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        },
        "tags": ["health"]
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "operationId": "HealthController_ready",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Pronto para receber tráfego",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "Banco de dados indisponível"
          }
        },
        "tags": ["health"]
      }
    },
    "/api/v1/sync/push": {
      "post": {
        "operationId": "SyncController_push",
        "parameters": [
          {
            "name": "x-dev-user-id",
            "in": "header",
            "description": "Provisório, só em desenvolvimento (ADR-0007)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SyncPushRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Lote aplicado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncPushResponse"
                }
              }
            }
          },
          "401": {
            "description": "Usuário não identificado"
          },
          "422": {
            "description": "Lote mal formado"
          }
        },
        "tags": ["sync"]
      }
    },
    "/api/v1/sync/pull": {
      "get": {
        "operationId": "SyncController_pull",
        "parameters": [
          {
            "name": "x-dev-user-id",
            "in": "header",
            "description": "Provisório, só em desenvolvimento (ADR-0007)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "since",
            "required": false,
            "in": "query",
            "schema": {
              "default": 0,
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "default": 1000,
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Mudanças depois do cursor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncPullResponse"
                }
              }
            }
          },
          "401": {
            "description": "Usuário não identificado"
          }
        },
        "tags": ["sync"]
      }
    }
  },
  "info": {
    "title": "Zooloo Finanças API",
    "description": "API REST do Zooloo Finanças. Erros em application/problem+json (RFC 9457).",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok"]
          }
        },
        "required": ["status"],
        "additionalProperties": false
      },
      "SyncPushRequest": {
        "type": "object",
        "properties": {
          "mutations": {
            "minItems": 1,
            "maxItems": 500,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "entity": {
                  "type": "string",
                  "enum": ["profiles", "categories"]
                },
                "id": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
                },
                "op": {
                  "type": "string",
                  "enum": ["upsert", "delete"]
                },
                "fields": {
                  "type": "object",
                  "additionalProperties": {
                    "$ref": "#/components/schemas/__schema0"
                  }
                },
                "hlc": {
                  "type": "string",
                  "pattern": "^\\d{15}-\\d{6}-[0-9a-f]{16}$"
                }
              },
              "required": ["entity", "id", "op", "fields", "hlc"],
              "additionalProperties": false
            }
          }
        },
        "required": ["mutations"],
        "additionalProperties": false
      },
      "__schema0": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 10000
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "string",
            "nullable": true,
            "enum": [null]
          },
          {
            "maxItems": 1000,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/__schema0"
            }
          },
          {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/__schema0"
            }
          }
        ]
      },
      "SyncPushResponse": {
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "rejected": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "index": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "reason": {
                  "type": "string",
                  "enum": ["invalid", "conflict", "not_found"]
                },
                "current": {
                  "nullable": true,
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SyncChange"
                    }
                  ]
                }
              },
              "required": ["index", "reason", "current"],
              "additionalProperties": false
            }
          }
        },
        "required": ["version", "rejected"],
        "additionalProperties": false
      },
      "SyncChange": {
        "type": "object",
        "properties": {
          "entity": {
            "type": "string",
            "enum": ["profiles", "categories"]
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "fields": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/__schema0"
            }
          },
          "clocks": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^\\d{15}-\\d{6}-[0-9a-f]{16}$"
            }
          }
        },
        "required": ["entity", "id", "version", "fields", "clocks"],
        "additionalProperties": false
      },
      "SyncPullResponse": {
        "type": "object",
        "properties": {
          "changes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SyncChange"
            }
          },
          "version": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "hasMore": {
            "type": "boolean"
          }
        },
        "required": ["changes", "version", "hasMore"],
        "additionalProperties": false
      }
    }
  }
}
