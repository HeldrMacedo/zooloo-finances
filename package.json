{
  "name": "zooloo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --max-warnings 0",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:mutation": "turbo run test:mutation",
    "depcruise": "depcruise apps packages --config .dependency-cruiser.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm depcruise && pnpm typecheck && pnpm test:coverage",
    "dev:worktree": "turbo run build --filter=@zooloo/dev-worktree... --filter=@zooloo/api... --output-logs=errors-only && node tools/dev-worktree/dist/cli.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "dependency-cruiser": "^18.8.0",
    "eslint": "^10.15.0",
    "eslint-plugin-security": "4.2.1",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "turbo": "^2.11.11",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  }
}
