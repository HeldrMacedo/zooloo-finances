{
  "name": "@zooloo/db-schema",
  "version": "0.0.0",
  "private": true,
  "description": "Esquema Drizzle: PostgreSQL (servidor, com RLS) e SQLite (cliente local).",
  "type": "module",
  "exports": {
    ".": {
      "@zooloo/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@zooloo/source": "./src/testing/postgres.ts"
    },
    "./migrate": {
      "@zooloo/source": "./src/pg/migrate.ts",
      "types": "./dist/pg/migrate.d.ts",
      "default": "./dist/pg/migrate.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate --config drizzle.pg.config.ts && drizzle-kit generate --config drizzle.sqlite.config.ts"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.1",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.1.0",
    "@zooloo/vitest-config": "workspace:*",
    "drizzle-kit": "0.31.11",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1"
  }
}
