{
  "name": "@zooloo/security",
  "version": "0.0.0",
  "private": true,
  "description": "Logger estruturado com mascaramento (SEC-LOG-01), utilitários de criptografia e sanitização.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@vitest/coverage-v8": "5.1.0",
    "fast-check": "4.10.2",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "@types/node": "26.6.6"
  }
}
